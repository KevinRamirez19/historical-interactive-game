    <effect id="Bodymat-fx" name="Bodymat">
      <profile_COMMON>
        <newparam sid="xd_Body_diffuse-surface">
          <surface type="2D">
            <init_from>xd_Body_diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="xd_Body_diffuse-sampler">
          <sampler2D>
            <source>xd_Body_diffuse-surface</source>
            <minfilter>LINEAR</minfilter>
            <magfilter>LINEAR</magfilter>
          </sampler2D>
        </newparam>
        <newparam sid="xd_Body_specular-surface">
          <surface type="2D">
            <init_from>xd_Body_specular-image</init_from>
          </surface>
        </newparam>
        <newparam sid="xd_Body_specular-sampler">
          <sampler2D>
            <source>xd_Body_specular-surface</source>
            <minfilter>LINEAR</minfilter>
            <magfilter>LINEAR</magfilter>
          </sampler2D>
        </newparam>
        <newparam sid="xd_Body_normal-surface">
          <surface type="2D">
            <init_from>xd_Body_normal-image</init_from>
          </surface>
        </newparam>
        <newparam sid="xd_Body_normal-sampler">
          <sampler2D>
            <source>xd_Body_normal-surface</source>
            <minfilter>LINEAR</minfilter>
            <magfilter>LINEAR</magfilter>
          </sampler2D>
        </newparam>
        <newparam sid="xd_Body_gloss-surface">
          <surface type="2D">
            <init_from>xd_Body_gloss-image</init_from>
          </surface>
        </newparam>
        <newparam sid="xd_Body_gloss-sampler">
          <sampler2D>
            <source>xd_Body_gloss-surface</source>
            <minfilter>LINEAR</minfilter>
            <magfilter>LINEAR</magfilter>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <phong>
            <emission>
              <color sid="emission">0.000000  0.000000 0.000000 1.000000</color>
            </emission>
            <ambient>
              <color sid="ambient">0.000000  0.000000 0.000000 1.000000</color>
            </ambient>
            <diffuse>
              <texture texture="xd_Body_diffuse-sampler" texcoord="CHANNEL0">
                <extra>
                  <technique profile="MAYA">
                    <wrapU sid="wrapU0">TRUE</wrapU>
                    <wrapV sid="wrapV0">TRUE</wrapV>
                    <blend_mode>ADD</blend_mode>
                  </technique>
                </extra>
                <extra type="texture_offset">
                  <technique profile="ADOBE">
                    <offsets>
                      <offsetu>0.000000</offsetu>
                      <offsetu>0.000000</offsetu>
                      <offsetv>0.000000</offsetv>
                      <scaleu>1.000000</scaleu>
                      <scalev>1.000000</scalev>
                      <angle>0.000000</angle>
                    </offsets>
                  </technique>
                </extra>
              </texture>
            </diffuse>
            <specular>
              <texture texture="xd_Body_specular-sampler" texcoord="CHANNEL0">
                <extra>
                  <technique profile="MAYA">
                    <wrapU sid="wrapU0">TRUE</wrapU>
                    <wrapV sid="wrapV0">TRUE</wrapV>
                    <blend_mode>ADD</blend_mode>
                  </technique>
                </extra>
                <extra type="texture_offset">
                  <technique profile="ADOBE">
                    <offsets>
                      <offsetu>0.000000</offsetu>
                      <offsetu>0.000000</offsetu>
                      <offsetv>0.000000</offsetv>
                      <scaleu>1.000000</scaleu>
                      <scalev>1.000000</scalev>
                      <angle>0.000000</angle>
                    </offsets>
                  </technique>
                </extra>
              </texture>
            </specular>
            <shininess>
              <float sid="shininess">20.000000</float>
              <texture texture="xd_Body_gloss-sampler" texcoord="CHANNEL0">
                <extra>
                  <technique profile="MAYA">
                    <wrapU sid="wrapU0">TRUE</wrapU>
                    <wrapV sid="wrapV0">TRUE</wrapV>
                    <blend_mode>ADD</blend_mode>
                  </technique>
                </extra>
                <extra type="texture_offset">
                  <technique profile="ADOBE">
                    <offsets>
                      <offsetu>0.000000</offsetu>
                      <offsetu>0.000000</offsetu>
                      <offsetv>0.000000</offsetv>
                      <scaleu>1.000000</scaleu>
                      <scalev>1.000000</scalev>
                      <angle>0.000000</angle>
                    </offsets>
                  </technique>
                </extra>
              </texture>
            </shininess>
            <reflective>
              <color sid="reflective">0.000000  0.000000 0.000000 1.000000</color>
            </reflective>
            <reflectivity>
              <float sid="reflectivity">1.000000</float>
            </reflectivity>
            <transparent opaque="RGB_ZERO">
              <color>0.000000 0.000000 0.000000 1.0</color>
            </transparent>
            <transparency>
              <float sid="transparency">0.000000</float>
            </transparency>
          </phong>
          <extra>
            <technique profile="FCOLLADA">
              <displacement>
                <texture texture="xd_Body_normal-sampler" texcoord="CHANNEL0">
                  <extra>
                    <technique profile="MAYA">
                      <wrapU sid="wrapU0">TRUE</wrapU>
                      <wrapV sid="wrapV0">TRUE</wrapV>
                      <blend_mode>ADD</blend_mode>
                    </technique>
                  </extra>
                  <extra type="texture_offset">
                    <technique profile="ADOBE">
                      <offsets>
                        <offsetu>0.000000</offsetu>
                        <offsetu>0.000000</offsetu>
                        <offsetv>0.000000</offsetv>
                        <scaleu>1.000000</scaleu>
                        <scalev>1.000000</scalev>
                        <angle>0.000000</angle>
                      </offsets>
                    </technique>
                  </extra>
                  <extra>
                    <technique profile="MAX3D">
                      <amount>1.000000</amount>
                    </technique>
                  </extra>
                </texture>
              </displacement>
            </technique>
          </extra>
        </technique>
      </profile_COMMON>
    </effect>
