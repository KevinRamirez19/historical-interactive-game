  m_Script: {fileID: 11500000, guid: c3bdd65d9d928874f9a3fe531ae4e483, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _panelPressE: {fileID: 1150780701}
  _panelMision: {fileID: 581178596}
  _textPanelMision: {fileID: 236154801}
  _inTrigger: 0
  _conversationSteps: 0
  _time: 0
  _miTexto: "\xA1Acaban de asesinar a Jorge Eliecer Gait\xE1n! Esto cambiar\xE1 el
    curso de la historia en Colombia. Era un l\xEDder popular, defensor de los derechos
    del pueblo. Vi que el asesino corri\xF3 por la calle de abajo. Si te das prisa,
    tal vez lo alcances. Pero cuidado, la ciudad est\xE1 al borde de la locura. Llevaba
    un sombrero oscuro y una chaqueta larga, como si quisiera pasar desapercibido,
    pero no conoc\xEDa la verdadera importancia de lo que acababa de hacer"
