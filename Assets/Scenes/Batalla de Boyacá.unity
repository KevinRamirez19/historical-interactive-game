--- !u!114 &355009446
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 355009443}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ba0dacbdc57daa4280f82709c60fa77, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mensaje: "\"Los conflictos en la Nueva Granada comenzaron por el deseo de independencia
    frente al dominio espa\xF1ol. Los patriotas, inspirados por ideales de libertad
    y justicia, decidieron actuar para lograr la independencia de la opresi\xF3n.
    Esta batalla, liderada por Sim\xF3n Bol\xEDvar y otros grandes l\xEDderes, fue
    el momento decisivo para liberarse del dominio colonial.\""
