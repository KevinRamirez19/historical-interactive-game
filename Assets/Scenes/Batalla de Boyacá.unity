  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ba0dacbdc57daa4280f82709c60fa77, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mensaje: "\"En las primeras horas del 7 de agosto de 1819, las tropas patriotas
    se encontraron con el ej\xE9rcito realista en el Puente de Boyac\xE1. Con t\xE1cticas
    organizadas y una distribuci\xF3n estrat\xE9gica de tropas, los patriotas se
    dispusieron a enfrentarse en una batalla decisiva. Con Bol\xEDvar al mando y
    Francisco de Paula Santander a su lado, el ej\xE9rcito se prepar\xF3 para un
    enfrentamiento crucial.\""
