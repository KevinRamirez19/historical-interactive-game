  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7ba0dacbdc57daa4280f82709c60fa77, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mensaje: "\"La batalla fue intensa y r\xE1pida. Las tropas patriotas atacaron con
    fuerza, mientras los realistas intentaron defenderse. A medida que avanzaban,
    el ej\xE9rcito patriota se gan\xF3 una ventaja crucial, rodeando a las fuerzas
    enemigas. La ubicaci\xF3n del puente y el elemento sorpresa jugaron un papel
    fundamental en el \xE9xito del plan de Bol\xEDvar.\""
