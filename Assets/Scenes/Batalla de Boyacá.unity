  m_Script: {fileID: 11500000, guid: 7ba0dacbdc57daa4280f82709c60fa77, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mensaje: "\"Tras la victoria en Boyac\xE1, se consolid\xF3 el sue\xF1o de libertad
    en Sudam\xE9rica. Colombia inici\xF3 un proceso de independencia que resultar\xEDa
    en la creaci\xF3n de una naci\xF3n soberana. Esta batalla tambi\xE9n impuls\xF3
    la causa en otros pa\xEDses del continente, lo que llevar\xEDa a la liberaci\xF3n
    de Venezuela, Ecuador, Per\xFA y Bolivia. \xA1Ahora has recolectado todos los
    artefactos y obtenido la espada legendaria de Simon Bolivar! Usa esta espada
    para continuar con tu misi\xF3n y descubrir nuevas historias de Colombia\""
